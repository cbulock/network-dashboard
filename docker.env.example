# Copy to .env on the deployment host. Use an existing PostgreSQL database.
# localhost means the container itself. Use a database host reachable from Docker.
# URL-encode special characters in the username/password.
DATABASE_URL=postgresql://dashboard:replace-me@postgres.example.internal:5432/network_dashboard
DASHBOARD_PORT=3000
# Optional: pin a version tag or immutable digest instead of latest.
# DASHBOARD_IMAGE=ghcr.io/cbulock/network-dashboard:latest

UNIFI_HOST=https://unifi.example.internal
UNIFI_USER=dashboard
UNIFI_PASS=replace-me
UNIFI_SITE=default
HA_URL=http://homeassistant.example.internal:8123
HA_TOKEN=replace-me
KUMA_METRICS_URL=http://kuma.example.internal:3001/metrics
KUMA_API_KEY=replace-me

# Optional: enable DNS Platform with compose.ssh.yaml and the worker profile.
# DASHBOARD_SSH_DIR=/absolute/host/path/to/dashboard-ssh
# DNS_PLATFORM_SSH_TARGET=dns-platform@tools.example.internal
# DNS_PLATFORM_SSH_KEY=/home/node/.ssh/id_ed25519
