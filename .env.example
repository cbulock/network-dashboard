# Existing collectors retain their own environment configuration.
DATABASE_URL=postgresql://user:password@localhost/network_dashboard
UNIFI_HOST=https://unifi.example.internal
UNIFI_USER=dashboard
UNIFI_PASS=replace-with-local-controller-password
UNIFI_SITE=default
# Restricted forced-command account on Tools. Private key stays on dashboard host.
DNS_PLATFORM_SSH_TARGET=dns-platform@tools.docker
DNS_PLATFORM_SSH_KEY=/absolute/path/to/dashboard-dns-key
